era-utocr:UtoCreationReason a skos:ConceptScheme ;
    rdfs:label "Uto Creation Reason"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-07-24"^^xsd:date ;
    skos:hiddenLabel "CCSTMS_UtoCreationReason"@en ;
    skos:prefLabel "Uto Creation Reason"@en .


