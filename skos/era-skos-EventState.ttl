@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix era-eventstate: <http://data.europa.eu/949/concepts/event-state/> .

#################################################################
#
#    Concept Schemes
#
#################################################################

era-eventstate:EventState a skos:ConceptScheme ;
    rdfs:label "Event State"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2025-02-19"^^xsd:date ;
    dct:modified "2025-03-06"^^xsd:date ,
                 "2026-07-24"^^xsd:date ;
    skos:hiddenLabel "CCSTMS_EventState" ;
    skos:prefLabel "Event State"@en .
	
	
#################################################################
#
#    Concept instances
#
#################################################################

era-eventstate:activated a skos:Concept ;
    skos:hiddenLabel "CCSTMS_activated_0" ;
    skos:inScheme era-eventstate:EventState ;
    skos:notation "activated"^^xsd:string ;
    skos:prefLabel "Activated"@en ;
    skos:topConceptOf era-eventstate:EventState .

era-eventstate:deactivated a skos:Concept ;
    rdfs:comment "deactivated = end of life. The area can not be re-activated."@en ;
    skos:hiddenLabel "CCSTMS_deactivated_1" ;
    skos:inScheme era-eventstate:EventState ;
    skos:notation "deactivated"^^xsd:string ;
    skos:prefLabel "Deactivated"@en ;
    skos:topConceptOf era-eventstate:EventState .