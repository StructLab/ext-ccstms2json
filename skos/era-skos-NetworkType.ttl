@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix era-nt: <http://data.europa.eu/949/concepts/network-type/> .


#################################################################
#
#    Concept Schemes
#
#################################################################


era-nt:NetworkType a skos:ConceptScheme ;
    rdfs:label "Network Type"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-07-24"^^xsd:date ;
    rdfs:comment "Qualifier for the Radio Network type. Indicates with which radio communication system(s) the trackside is fitted."@en ;
    skos:hiddenLabel "CCSTMS_NetworkType"@en ;
    skos:prefLabel "Network Type"@en .


#################################################################
#
#    Concept instances
#
#################################################################


era-nt:FRMCS a skos:Concept ;
    rdfs:comment "Trackside is fitted with FRMCS only"@en ;
    skos:hiddenLabel "CCSTMS_FRMCS_0"@en ;
    skos:inScheme era-nt:NetworkType ;
    skos:notation "FRMCS"^^xsd:string ;
    skos:prefLabel "FRMCS"@en ;
    skos:topConceptOf era-nt:NetworkType .

era-nt:FRMCS_GSMR a skos:Concept ;
    rdfs:comment "Trackside is fitted with both FRMCS and GSM-R"@en ;
    skos:hiddenLabel "CCSTMS_FRMCS_GSMR_1"@en ;
    skos:inScheme era-nt:NetworkType ;
    skos:notation "FRMCS_GSMR"^^xsd:string ;
    skos:prefLabel "FRMCS GSM-R"@en ;
    skos:topConceptOf era-nt:NetworkType .

era-nt:GSMR a skos:Concept ;
    rdfs:comment "Trackside is fitted with GSM-R only"@en ;
    skos:hiddenLabel "CCSTMS_GSMR_2"@en ;
    skos:inScheme era-nt:NetworkType ;
    skos:notation "GSMR"^^xsd:string ;
    skos:prefLabel "GSM-R"@en ;
    skos:topConceptOf era-nt:NetworkType .