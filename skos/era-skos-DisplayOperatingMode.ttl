#################################################################
#
#    Concept Schemes
#
#################################################################

era-dom:DisplayOperatingMode a skos:ConceptScheme ;
    rdfs:label "Display Operating Mode"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2025-02-19"^^xsd:date ;
    dct:modified "2025-03-06"^^xsd:date ;
    rdfs:comment "Onboard operating mode for text display.The text is displayed when entering / as long as in the defined mode. "@en ;
    skos:hiddenLabel "CCSTMS_DisplayOperatingMode" ;
    skos:prefLabel "Display Operating Mode"@en .
	
	
