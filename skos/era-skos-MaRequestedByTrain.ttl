era-marbt:MaRequestedByTrain a skos:ConceptScheme ;
    rdfs:label "Ma Requested By Train"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-07-24"^^xsd:date ;
    rdfs:comment "Qualifier to indicate the reason why the MA request is sent to the RBC. see ss026, 7.5.1.118.3 Q_MARQSTREASON"@en ;
    skos:hiddenLabel "CCSTMS_MaRequestedByTrain"@en ;
    skos:prefLabel "Ma Requested By Train"@en .


