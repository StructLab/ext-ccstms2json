@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix era-rcm: <http://data.europa.eu/949/concepts/response-code-movement/> .

#################################################################
#
#    Concept Schemes
#
#################################################################

era-rcm:ResponseCodeMovement a skos:ConceptScheme ;
    rdfs:label "Response Code Movement"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2025-02-19"^^xsd:date ;
    dct:modified "2025-03-06"^^xsd:date ,
                 "2026-07-24"^^xsd:date ;
    skos:hiddenLabel "CCSTMS_ResponseCodeMovement" ;
    skos:prefLabel "Response Code Movement"@en .
	
	
#################################################################
#
#    Concept instances
#
#################################################################

era-rcm:accepted a skos:Concept ;
    skos:hiddenLabel "CCSTMS_accepted_0" ;
    skos:inScheme era-rcm:ResponseCodeMovement ;
    skos:notation "accepted"^^xsd:string ;
    skos:prefLabel "Accepted"@en ;
    skos:topConceptOf era-rcm:ResponseCodeMovement .

era-rcm:anyRejectReason a skos:Concept ;
    skos:hiddenLabel "CCSTMS_anyRejectReason_1" ;
    skos:inScheme era-rcm:ResponseCodeMovement ;
    skos:notation "anyRejectReason"^^xsd:string ;
    skos:prefLabel "Any Reject Reason"@en ;
    skos:topConceptOf era-rcm:ResponseCodeMovement .