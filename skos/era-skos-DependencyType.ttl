@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix era-dependency-type: <http://data.europa.eu/949/concepts/dependency-type/> .

#################################################################
#
#    Concept Schemes
#
#################################################################


era-dependency-type:DependencyType a skos:ConceptScheme ;
    rdfs:label "Dependency Type"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2025-02-19"^^xsd:date ;
    dct:modified "2025-03-06"^^xsd:date ,
                 "2026-07-24"^^xsd:date ;
    rdfs:comment "Defines the type of DPS dependency"@en ;
    skos:hiddenLabel "CCSTMS_DependencyType" ;
    skos:prefLabel "Dependency Type"@en .	
	
#################################################################
#
#    Concept instances
#
#################################################################


era-dependency-type:equivalent a skos:Concept ;
    skos:hiddenLabel "CCSTMS_equivalent_1" ;
    skos:inScheme era-dependency-type:DependencyType ;
    skos:notation "equivalent"^^xsd:string ;
    skos:prefLabel "Equivalent"@en ;
    skos:topConceptOf era-dependency-type:DependencyType .

era-dependency-type:exclusive a skos:Concept ;
    skos:hiddenLabel "CCSTMS_exclusive_0" ;
    skos:inScheme era-dependency-type:DependencyType ;
    skos:notation "exclusive"^^xsd:string ;
    skos:prefLabel "Exclusive"@en ;
    skos:topConceptOf era-dependency-type:DependencyType .

era-dependency-type:specific a skos:Concept ;
    skos:hiddenLabel "CCSTMS_specific_2" ;
    skos:inScheme era-dependency-type:DependencyType ;
    skos:notation "specific"^^xsd:string ;
    skos:prefLabel "Specific"@en ;
    skos:topConceptOf era-dependency-type:DependencyType .