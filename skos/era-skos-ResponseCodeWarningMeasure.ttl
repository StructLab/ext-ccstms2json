@prefix cc: <http://creativecommons.org/ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix era-rcwm: <http://data.europa.eu/949/concepts/rcwm/> .


#################################################################
#
#    Concept Schemes
#
#################################################################


era-rcwm:ResponseCodeWarningMeasure a skos:ConceptScheme ;
    rdfs:label "Response Code Warning Measure"@en ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-07-24"^^xsd:date ;
    skos:hiddenLabel "CCSTMS_ResponseCodeWarningMeasure"@en ;
    skos:prefLabel "Response Code Warning Measure"@en .


#################################################################
#
#    Concept instances
#
#################################################################


era-rcwm:accepted a skos:Concept ;
    skos:hiddenLabel "CCSTMS_accepted_0"@en ;
    skos:inScheme era-rcwm:ResponseCodeWarningMeasure ;
    skos:notation "accepted"^^xsd:string ;
    skos:prefLabel "Accepted"@en ;
    skos:topConceptOf era-rcwm:ResponseCodeWarningMeasure .

era-rcwm:anyRejectReason a skos:Concept ;
    skos:hiddenLabel "CCSTMS_anyRejectReason_1"@en ;
    skos:inScheme era-rcwm:ResponseCodeWarningMeasure ;
    skos:notation "anyRejectReason"^^xsd:string ;
    skos:prefLabel "Any Reject Reason"@en ;
    skos:topConceptOf era-rcwm:ResponseCodeWarningMeasure .